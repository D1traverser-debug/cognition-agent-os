{
  "description": "Read-only source-of-truth recovery for cognition-agent-os on new or compacted Codex sessions; no implicit task/effect authorization.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_session_context.py\"",
            "timeout": 8,
            "additionalContextLimit": 2000,
            "statusMessage": "Reattesting original goal from existing local SQLite",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/scripts/codex_session_context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__GitHub__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/verify_ci_evidence_scope.py\" --codex-pretool",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/scripts/verify_ci_evidence_scope.py\" --codex-pretool",
            "timeout": 8,
            "statusMessage": "Checking previously verified experiment evidence before external action"
          }
        ]
      }
    ]
  }
}
